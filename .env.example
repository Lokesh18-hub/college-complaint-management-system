# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET="ccms_super_secure_jwt_secret_key_2026_campus_complaints"
JWT_EXPIRES_IN="7d"

# Supabase Credentials (Optional for client-side / storage integrations)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# ⚠️ SERVICE ROLE KEY IS SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# File Upload Storage (optional Cloudinary integration; defaults to local storage if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
