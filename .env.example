# Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Supports PostgreSQL e.g. Neon, Supabase, Local Postgres, or SQLite dev fallback)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ccms_db?schema=public"

# JWT Authentication
JWT_SECRET="ccms_super_secure_jwt_secret_key_2026_campus_complaints"
JWT_EXPIRES_IN="7d"

# File Upload Storage (optional Cloudinary integration; defaults to local storage if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
